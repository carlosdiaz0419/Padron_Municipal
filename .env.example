# En Vercel: Se pueden configurar en Project Settings > Environment Variables
# Si no se definen, el proyecto utiliza por defecto el backend en Railway y
# las reglas de proxy inverso en vercel.json.

VITE_BACKEND_URL=https://backend-beneficiarios-production.up.railway.app
VITE_API_URL=https://backend-beneficiarios-production.up.railway.app
