{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/beneficiarios/:path*",
      "destination": "https://backend-beneficiarios-production.up.railway.app/api/beneficiarios/:path*"
    },
    {
      "source": "/api/beneficiarios",
      "destination": "https://backend-beneficiarios-production.up.railway.app/api/beneficiarios"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://backend-beneficiarios-production.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/api/auth",
      "destination": "https://backend-beneficiarios-production.up.railway.app/api/auth"
    },
    {
      "source": "/api/catalogos/:path*",
      "destination": "https://backend-beneficiarios-production.up.railway.app/api/catalogos/:path*"
    },
    {
      "source": "/api/catalogos",
      "destination": "https://backend-beneficiarios-production.up.railway.app/api/catalogos"
    },
    {
      "source": "/health",
      "destination": "https://backend-beneficiarios-production.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
